# For Docker Compose and the website, and optional: the app's other settings are in backend/.env.

# "production" also starts the services that only production needs.
COMPOSE_PROFILES=

# The ports on this machine, open to this machine only.
WEB_PORT=8004
STREAM_PORT=8104
FRONTEND_PORT=3004
POSTGRES_PORT=5448

# Who runs this installation. Contact, privacy, terms and refunds only exist with a name and an email.
COMPANY_NAME=
COMPANY_EMAIL=
COMPANY_ADDRESS=
# Whose law the terms follow, e.g. India.
COMPANY_JURISDICTION=
