# In production: whileisleep.settings.production, and everything in the block below.
DJANGO_SETTINGS_MODULE=whileisleep.settings.local
# In production: production. Also starts the services that only production needs.
COMPOSE_PROFILES=

# The ports Docker opens, to this machine only. POSTGRES_PORT below is one too.
WEB_PORT=8004
STREAM_PORT=8104

# Production only.
# The public address, e.g. https://chat.example.com
SITE_URL=
# openssl rand -base64 48
DJANGO_SECRET_KEY=
# Encrypts API keys stored in the database. Keep a copy elsewhere: without it they can't be read.
# openssl rand -base64 32 | tr '+/' '-_'
ENCRYPTION_KEYS=
# Set to false once your own accounts exist, so strangers can't sign up on your server.
SIGNUP_ENABLED=true

# Postgres runs in Docker (docker compose up -d db), published on localhost only.
# In production set your own password before the first start: openssl rand -hex 24
POSTGRES_DB=whileisleep
POSTGRES_USER=whileisleep
POSTGRES_PASSWORD=whileisleep
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5448

# manage.py seed_demo creates this owner (local testing only).
DEMO_EMAIL=demo@whileisleep.test
DEMO_PASSWORD=

# Where uploaded files go: an S3-compatible bucket. Set all five, or leave all empty.
# Everything in the bucket is public at STORAGE_PUBLIC_BASE_URL. Test the settings with:
#   python manage.py check_storage
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
STORAGE_BUCKET=
STORAGE_PUBLIC_BASE_URL=
# Only for providers with regions. Cloudflare R2 needs none.
# S3_REGION=

# Selling the hosted plan with Dodo Payments. Leave empty on your own server: everything is free.
# Put the test key and https://test.dodopayments.com here first, then run:
#   python manage.py billing_setup
# Payments work without the webhook key.
PAYMENT_PROVIDER=
DODO_BASE_URL=
DODO_API_KEY=
DODO_PRODUCT_MONTHLY=
DODO_PRODUCT_YEARLY=
DODO_WEBHOOK_KEY=

# Slack: your own Slack app (frontend/content/docs/slack.md). Leave empty and Slack stays off.
PLUGIN_SLACK_CLIENT_ID=
PLUGIN_SLACK_CLIENT_SECRET=
PLUGIN_SLACK_SIGNING_SECRET=
# Plugins of your own, as importable modules with commas between (docs/plugins.md).
# EXTRA_PLUGINS=

# Google's reCAPTCHA v2 checkbox ("I'm not a robot") at log-in and sign-up. Both, or neither.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# "Continue with Google" at log-in. Both, or neither. The client's redirect URI is
# SITE_URL/api/v1/auth/google/callback (http://localhost:3004 in development).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Emails (a forgotten password), through Brevo. MAIL_FROM must be a sender Brevo has verified.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=
