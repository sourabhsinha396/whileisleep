WEB_PORT=8004
DJANGO_SETTINGS_MODULE=whileisleep.settings.local
DJANGO_SECRET_KEY=

# Postgres runs in Docker (docker compose up -d db), published on localhost only.
POSTGRES_DB=whileisleep
POSTGRES_USER=whileisleep
POSTGRES_PASSWORD=whileisleep
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5448

# The AI agent's OpenRouter key and model are set per organization in the dashboard
# (Organization page). seed_demo copies this one into the demo organization; optional.
OPENROUTER_API_KEY=

# manage.py seed_demo creates this owner (local testing only).
DEMO_EMAIL=demo@whileisleep.test
DEMO_PASSWORD=
EXAMGRILL_API_URL=http://host.docker.internal:8006
