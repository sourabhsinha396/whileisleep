{
  "display_information": {
    "name": "whileisleep",
    "description": "Customer chats that need a person, answered from Slack.",
    "background_color": "#1d4ed8"
  },
  "features": {
    "bot_user": {
      "display_name": "whileisleep",
      "always_online": true
    }
  },
  "oauth_config": {
    "redirect_urls": ["https://YOUR_DOMAIN/integrations/callback"],
    "scopes": {
      "bot": [
        "channels:history",
        "channels:join",
        "channels:read",
        "chat:write",
        "groups:history",
        "groups:read",
        "reactions:write",
        "users:read",
        "users:read.email"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://YOUR_DOMAIN/api/v1/integrations/slack/webhook",
      "bot_events": ["app_uninstalled", "message.channels", "message.groups", "tokens_revoked"]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://YOUR_DOMAIN/api/v1/integrations/slack/webhook"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
