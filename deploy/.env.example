# Copy to deploy/.env and fill in. docs/deploy-vm.md explains each step.

# The domain people will open, with a DNS A record pointing at this server.
SITE_DOMAIN=chat.example.com

# A long random string. Make one with:  openssl rand -base64 48
DJANGO_SECRET_KEY=

# Encrypts API keys stored in the database. Make one with:
#   openssl rand -base64 32 | tr '+/' '-_'
# Keep a copy somewhere safe: without it the stored keys can't be read.
ENCRYPTION_KEYS=

# The database's password (only used inside this server). Make one with:  openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=whileisleep
POSTGRES_USER=whileisleep

# Set to false once your own accounts exist, so strangers can't sign up on your server.
SIGNUP_ENABLED=true

# Set to true only if your AI tools call services on this server's private network.
# OUTBOUND_ALLOW_PRIVATE_NETWORKS=false

# Where uploaded files go: an S3-compatible bucket. Set all five, or leave all empty.
# Everything in the bucket is public at STORAGE_PUBLIC_BASE_URL. Test the settings with:
#   docker compose exec web python manage.py check_storage
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
STORAGE_BUCKET=
STORAGE_PUBLIC_BASE_URL=
# Only for providers with regions. Cloudflare R2 needs none.
# S3_REGION=

# Selling the hosted plan with Dodo Payments. Leave empty on your own server: everything is free.
# docs/deploy-vm.md explains the steps; set all of them, or none.
PAYMENT_PROVIDER=
DODO_BASE_URL=
DODO_API_KEY=
DODO_PRODUCT_MONTHLY=
DODO_PRODUCT_YEARLY=
DODO_WEBHOOK_KEY=
