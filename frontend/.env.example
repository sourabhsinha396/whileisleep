# The dashboard's port, in development and with pm2.
WEB_PORT=3004
# Django, from docker compose in backend/.
API_URL=http://localhost:8004
# Django's ASGI process, for the live streams (the `stream` service).
STREAM_URL=http://localhost:8104

# Who runs this installation. Contact, privacy, terms and refunds only exist with a name and an email.
COMPANY_NAME=
COMPANY_EMAIL=
COMPANY_ADDRESS=
# Whose law the terms follow, e.g. India.
COMPANY_JURISDICTION=

# Session replays with PostHog, read while building. Leave empty and nothing is loaded or recorded.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
