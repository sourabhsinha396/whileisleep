{
  "name": "whileisleep-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm build:flags && pnpm build:widget && next build",
    "build:flags": "node scripts/flags.mjs",
    "build:widget": "esbuild src/widget/index.ts --bundle --minify --format=iife --target=es2019 --outfile=public/widget.js",
    "watch:widget": "esbuild src/widget/index.ts --bundle --format=iife --target=es2019 --outfile=public/widget.js --watch",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tiptap/extension-image": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "clsx": "^2.1.1",
    "country-flag-icons": "1.6.20",
    "lucide-react": "^1.61.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.25.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "happy-dom": "^20.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@10.33.1"
}
